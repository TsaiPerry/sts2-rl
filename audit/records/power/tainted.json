    {
      "what": "TaintedPower.cs:24-27 `!props.IsPoweredAttack()` -> 0m",
      "verdict": "faithful",
      "rationale": "Enforced by DamageCmd.deal's is_powered_attack gate (cmds.py:56-58)."
